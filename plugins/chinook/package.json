{
  "name": "chinook-dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chinook business plugin for the DSH runtime: tools, services, identity and persistence for the Chinook Music Store agent.",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "better-sqlite3": "^12.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
