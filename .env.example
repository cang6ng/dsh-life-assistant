# DSH Life Assistant — environment
# Copy to .env (or export in your shell) and fill in your key.

# Primary credential for the DeepSeek-compatible model endpoint used by the
# dsh deepseek adapter. Env wins over the credential store.
DEEPSEEK_API_KEY=sk-your-key

# Fallback bridge: when DEEPSEEK_API_KEY is unset the agent accepts an
# Anthropic-format token here (the DeepSeek-compatible endpoint speaks it).
# ANTHROPIC_AUTH_TOKEN=sk-ant-...

# Demo identity (V1): the "logged-in" customer whose orders/invoices the
# agent may read. 1 = Luís Gonçalves (7 invoices). Unset/invalid => anonymous:
# order/invoice/memory tools answer IDENTITY_REQUIRED.
# CHINOOK_CUSTOMER_ID=1

# Optional: project-local DSH home override (defaults to <repo>/.dsh).
# DSH_HOME=...

# Optional: explicit database paths (defaults resolve under $DSH_HOME/data,
# mirrored from the repository by `pnpm bootstrap`).
# CHINOOK_DB_PATH=...
# CHINOOK_MEMORY_DB_PATH=...
