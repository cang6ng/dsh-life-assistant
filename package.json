{
  "name": "dsh-life-assistant",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "DSH Life Assistant — an extensible personal AI assistant built on DeepSeek Harness (DSH). Chinook Music is the first implemented domain (CLI + Windows desktop).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc -p plugins/chinook/tsconfig.build.json",
    "build:plugin": "tsc -p plugins/chinook/tsconfig.build.json",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test": "vitest run",
    "pretest": "tsx scripts/bootstrap.ts && tsc -p plugins/chinook/tsconfig.build.json",
    "chinook-agent": "tsx apps/cli/src/main.ts",
    "prechinook-agent": "tsc -p plugins/chinook/tsconfig.build.json",
    "dev": "pnpm run chinook-agent"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "@tauri-apps/api": "^2.11.1",
    "better-sqlite3": "^12.2.0",
    "chinook-dsh-plugin": "file:plugins/chinook",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  }
}
