{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": ["apps", "plugins", "profiles", "scripts", "tests"],
  // The React surface is its own project (apps/desktop/tsconfig.json — DOM
  // lib + jsx). The node suite only pulls in the pure store modules that the
  // tests import; the reducer chain is DOM-free.
  "exclude": ["apps/desktop/src"]
}
